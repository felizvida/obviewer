<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS-enforced: the app can only read files the user chooses, never write them. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Printing through the system print panel. (Its "Save as PDF" needs a save panel, which a read-only sandbox cannot show; the app opens PDFs in Preview instead.) -->
	<key>com.apple.security.print</key>
	<true/>
	<!--
	  Required by WebKit, not used by Obviewer: a sandboxed app's WKWebView helper
	  processes refuse to start without it, even for offline content (verified
	  2026-11-13; see docs/READER_ARCHITECTURE.md). Obviewer makes no network
	  requests; the reader blocks every non-local load with a content rule list,
	  a Content-Security-Policy and a navigation policy. Incoming connections
	  (network.server) remain forbidden.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
